<p style="color: green"><%= notice %></p>
<% content_for :title, @site.name %>

<%= render partial: "header", locals: { site: @site } %>

<div class="card main-card">
  <div class="card-header">
    <div class="d-flex justify-content-between">
      <h4><%= @site.name %> Details</h4>
      <div>
        <% if policy(@site).edit? %>
          <%= link_to edit_site_path(@site), class: 'btn btn-primary' do %>
            <i class="fas fa-edit"></i> Edit
          <% end %>
        <% end %>
        <% if policy(@site).destroy? %>
          <%= link_to @site, data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this site?" }, class: "btn btn-danger" do %>
            <i class="fas fa-trash"></i> Delete
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
  <div class="card-body">
    <%= render partial: "site", locals: { site: @site } %>
  </div>
</div>
