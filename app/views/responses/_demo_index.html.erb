<div class="card-header d-flex justify-content-between align-items-center">
  <h3 class="card-title mb-0"><%= @questionnaire.title.titleize %> Responses</h3>
</div>
<div class="card-body">
  <div class="table-responsive">
    <table class="table table-hover">
      <thead>
        <tr>
          <th>Participant</th>
          <th>Done On</th>
          <th>Entered By</th>
          <th>Discard</th>
        </tr>
      </thead>
      <tbody>
        <% @responses.each do |response| %>
          <tr scope="row">
            <td><%= response.participant ? (link_to response.index_demo_label, response.participant) : '' %></td>
            <td><%= link_to response.created_at.strftime("%F"), questionnaire_response_path(response.questionnaire, response) %></td>
            <td><%= response.user.name if response.user %></td>
            <td>
              <% if policy(response).destroy? %>
                <%= link_to questionnaire_response_path(response.questionnaire, response), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to discard this response?" }, class: 'btn btn-sm btn-danger' do %>
                  <i class="fa fa-trash"></i>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
