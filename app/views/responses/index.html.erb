<% content_for :title, "#{@questionnaire.title.titleize} Responses" %>

<div class="card main-card">
<% if @questionnaire.demographics? %>
  <%= render 'demo_index' %>
<% elsif @questionnaire.fidelity? %>
  <%= render 'fid_index' %>
<% elsif @questionnaire.observation? %>
  <%= render 'obs_index' %>
<% end %>
</div>
