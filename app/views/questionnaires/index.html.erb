<% content_for :title, "Survey Forms" %>
<p style="color: green"><%= notice %></p>

<div class="card main-card">
  <div class="card-header">
    <h3>Forms</h3>
  </div>

  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover">
        <thead>
          <tr>
            <th>Title</th>
            <th>Responses</th>
          </tr>
        </thead>
        <tbody>
          <% @questionnaires.each do |questionnaire| %>
            <tr scope="row">
              <td><%= link_to questionnaire.title.titleize, questionnaire %></td>
              <td>
                <% if questionnaire.event? %>
                  <%= link_to questionnaire.responses.size, events_path %>
                <% else %>
                  <%= link_to questionnaire.responses.size, questionnaire_responses_path(questionnaire) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
