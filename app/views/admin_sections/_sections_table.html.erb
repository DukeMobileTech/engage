<% if sections.any? %>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Site</th>
          <th>Section</th>
          <th>Demographics</th>
          <th>Lessons</th>
          <th>Fidelity</th>
          <th>Attendance</th>
          <th>Completed</th>
        </tr>
      </thead>
      <tbody>
        <% sections.each do |section| %>
          <tr>
            <td class="fw-semibold"><%= link_to section.site.name, site_path(section.site) %></td>
            <td class="fw-semibold"><%= link_to section.short_name, site_section_path(section.site, section) %></td>
            <td>
              <div class="progress-bar">
                <div class="progress-fill" style="width: <%= section.demographics_progress_percentage %>%"></div>
              </div>
              <small><%= link_to section.demographics_progress_label, site_section_section_participants_path(section.site, section) %></small>
            </td>
            <td>
              <div class="progress-bar">
                <div class="progress-fill" style="width: <%= section.progress_percentage %>%"></div>
              </div>
              <small><%= link_to section.progress_label, site_section_sittings_path(section.site, section) %></small>
            </td>
            <td>
              <div class="progress-bar">
                <div class="progress-fill" style="width: <%= section.fidelity_progress_percentage %>%"></div>
              </div>
              <small><%= link_to section.fidelity_progress_label, fidelity_logs_site_section_path(section.site, section) %></small>
            </td>
            <td>
              <% if section.average_attendance >= 75.0 %>
                <span class="badge bg-success"><%= section.average_attendance %>% avg</span>
              <% elsif section.average_attendance >= 50.0 %>
                <span class="badge bg-warning"><%= section.average_attendance %>% avg</span>
              <% else %>
                <span class="badge bg-danger"><%= section.average_attendance %>% avg</span>
              <% end %>
            </td>
            <td>
              <% if section.completed? %>
                <span class="badge bg-success">Yes</span>
              <% else %>
                <span class="badge bg-danger">No</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="p-3 text-muted text-center">
    <i class="fa-solid fa-inbox me-2"></i> No sections in this category
  </div>
<% end %>
