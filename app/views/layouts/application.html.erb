<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "ENC-HEAL TEACH" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="turbo-prefetch" content="false">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= favicon_link_tag asset_path("favicon.ico") %>
    <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.7.2/css/all.min.css", rel: "stylesheet", crossorigin: "anonymous" %>
    <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/slim-select@2.12.1/dist/slimselect.min.css", rel: "stylesheet", crossorigin: "anonymous" %>
    <%= Sentry.get_trace_propagation_meta.html_safe %>
  </head>

  <body>
    <div class="bs-component">
      <nav class="navbar navbar-expand-lg fixed-top bg-primary" data-bs-theme="dark">
        <div class="container-fluid ms-5 me-5">
          <%= link_to image_tag("logo.png"), root_path, class: "navbar-brand" %>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarId" aria-controls="navbarId" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="navbarId">
            <ul class="navbar-nav me-auto">
              <li class="nav-item"><%= link_to "Sites", sites_path, class: "nav-link #{is_nav_active?("organizations", "sites", "sections", "site_participants", "section_participants", "sittings", "lesson_attendances", "section_participant_responses", "admin_sections")}" %></li>
              <li class="nav-item"><%= link_to "Participants", participants_path, class: "nav-link #{is_nav_active?('participants')}" %></li>
              <li class="nav-item"><%= link_to "Forms", questionnaires_path, class: "nav-link #{is_nav_active?('questionnaires', 'responses')}" %></li>
              <li class="nav-item"><%= link_to "Events", events_path, class: "nav-link #{is_nav_active?('events')}" %></li>
              <li class="nav-item"><a href="https://dukemobiletech.github.io/engage/" target="_blank" class="nav-link">Manual</a></li>
            </ul>
            <% if Current.user&.admin? %>
              <ul class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                  <i class="fa-solid fa-gears"></i> Admin
                </a>
                <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                  <li><%= link_to "Organizations", organizations_path, class: "dropdown-item #{is_nav_active?('organizations') ? 'active' : ''}" %></li>
                  <li><%= link_to "Sections", sections_path, class: "dropdown-item #{is_nav_active?('sections') ? 'active' : ''}" %></li>
                  <li><%= link_to "Exports", data_uploads_path, class: "dropdown-item #{is_nav_active?('data_uploads') ? 'active' : ''}" %></li>
                  <li><%= link_to "Curriculums", curriculums_path, class: "dropdown-item #{is_nav_active?('curriculums') ? 'active' : ''}" %></li>
                  <li><%= link_to "Users", users_path, class: "dropdown-item #{is_nav_active?('users') ? 'active' : ''}" %></li>
                </ul>
              </ul>
            <% end %>
            <div class="d-flex ms-auto">
              <% if authenticated? %>
                <span class="me-2">
                  <%= link_to profile_user_path(Current.user), class: "bg-white text-dark p-2 rounded text-decoration-none" do %>
                    <i class="fa-solid fa-user"></i> <strong><%= Current.user.display_name %></strong>
                  <% end %>
                </span>
              <% else %>
                <%= link_to "Sign In", new_session_path, class: "btn btn-outline-primary me-2" unless current_page?(new_session_path) %>
              <% end %>
            </div>
          </div>
        </div>
      </nav>
    </div>

    <div class="container">
      <%= yield %>
    </div>
  </body>
</html>
