<!-- Breadcrumb Navigation -->
<nav aria-label="Breadcrumb" class="mb-3">
  <ol class="breadcrumb mb-0">
    <li class="breadcrumb-item"><%= link_to site.organization.name, organization_path(site.organization) %></li>
    <li class="breadcrumb-item"><%= link_to site.name, site_sections_path(site) %></li>
    <li class="breadcrumb-item active"><%= link_to section.curriculum.title, curriculum_path(section.curriculum) %></li>
  </ol>
</nav>

<!-- Section Header -->
<div class="mb-4">
  <h3 class="mb-1"><%= section.name %></h3>
  <p class="text-muted mb-3">
    <i class="fa-solid fa-calendar me-2"></i>
    <%= section.start_date.strftime("%b %d, %Y") %> – <%= section.end_date.strftime("%b %d, %Y") %>
  </p>

  <!-- Tab Navigation -->
  <ul class="nav nav-tabs border-bottom">
    <li class="nav-item">
      <%= link_to site_section_path(site, section), class: "nav-link #{params[:action] == 'show' || params[:action].nil? ? 'active' : ''}" do %>
        <i class="fa-solid fa-home me-2"></i> Home
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to site_section_section_participants_path(site, section), class: "nav-link #{params[:controller].include?('section_participants') ? 'active' : ''}" do %>
        <i class="fa-solid fa-users me-2"></i> Participants
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to site_section_sittings_path(site, section), class: "nav-link #{params[:controller].include?('sittings') ? 'active' : ''}" do %>
        <i class="fa-solid fa-clock me-2"></i> Sessions
      <% end %>
    </li>
  </ul>
</div>
