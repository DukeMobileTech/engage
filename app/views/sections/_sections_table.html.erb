<% if sections.any? %>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Section Name</th>
          <th>Participants</th>
          <th>Progress</th>
          <th>Attendance</th>
          <th>Completed</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% sections.each do |section| %>
          <tr>
            <td class="fw-semibold"><%= link_to section.short_name, site_section_path(site, section) %></td>
            <td><%= section.participants.size %></td>
            <td>
              <div class="progress-bar">
                <div class="progress-fill" style="width: <%= section.progress_percentage %>%"></div>
              </div>
              <small><%= "#{section.progress_label} (#{section.progress_percentage}%)" %></small>
            </td>
            <td>
              <% if section.average_attendance >= 75.0 %>
                <span class="badge bg-success"><%= section.average_attendance %>% avg</span>
              <% elsif section.average_attendance >= 50.0 %>
                <span class="badge bg-warning"><%= section.average_attendance %>% avg</span>
              <% else %>
                <span class="badge bg-danger"><%= section.average_attendance %>% avg</span>
              <% end %>
            </td>
            <td>
              <% if section.completed? %>
                <span class="badge bg-success">Yes</span>
              <% else %>
                <span class="badge bg-danger">No</span>
              <% end %>
            </td>
            <td>
              <%= link_to fidelity_logs_site_section_path(site, section), class: "btn btn-sm btn-outline-primary" do %>
                <i class="fa-solid fa-file-lines"></i> Logs
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="p-3 text-muted text-center">
    <i class="fa-solid fa-inbox me-2"></i> No sections in this category
  </div>
<% end %>
