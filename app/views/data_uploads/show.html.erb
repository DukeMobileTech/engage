<div class="mb-5">
  <p style="color: green"><%= notice %></p>
  <h2 class="text-center"><%= @data_upload.name %></h2>

  <div class="card border-0 bg-light mb-4">
    <div class="card-body">
      <div class="row">
        <div class="col-md-6">
          <p class="mb-2"><b>Reporting Period:</b></p>
          <p class="ms-3"><%= @data_upload.reporting_period_start %> to <%= @data_upload.reporting_period_end %></p>
        </div>
        <div class="col-md-6">
          <p class="mb-2"><b>Site Included:</b></p>
          <p class="ms-3"><%= @data_upload.include_site ? "✓ Yes" : "✗ No" %></p>
        </div>
      </div>

      <hr>

      <div>
        <p class="mb-3">
          <b>Sections (<span class="badge bg-primary"><%= @data_upload.sections.count %></span>)</b>
        </p>
        <div class="d-flex flex-wrap gap-2">
          <% @data_upload.sections.each do |section| %>
            <span class="badge bg-info" style="font-size: 0.75rem; padding: 0.5rem 0.5rem;">
              <%= section.name %>
            </span>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  <div class="card main-card">
    <div class="card-header">
      <h4>Section Data Export Reports</h4>
    </div>

    <div class="card-body">
      <div class="d-flex flex-row-reverse m-1">
        <%= link_to 'Generate Data Export', generate_report_data_upload_path(@data_upload), "data-turbo-method": :post, class: 'btn btn-success' %>
      </div>
      <table class="table table-striped">
        <thead>
          <tr>
            <th>Filename</th>
            <th>Download</th>
            <th>Delete</th>
          </tr>
        </thead>
        <tbody>
          <% @data_upload.reports.order(created_at: :desc).each do |report| %>
            <tr>
              <td><%= report.filename %></td>
              <td><%= link_to "Download", rails_blob_path(report, disposition: "attachment"), class: 'btn btn-primary' %></td>
              <td><%= link_to "Delete", active_storage_attachment_path(report), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: 'btn btn-danger' %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="d-flex flex-row-reverse">
    <%= link_to "Edit this data export", edit_data_upload_path(@data_upload), class: "btn btn-primary" %>
  </div>
</div>
