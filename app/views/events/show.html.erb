<% content_for :title, "#{@questionnaire.title} Events" %>

<div class="main-card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h3 class="text-center"><%= "#{@questionnaire.title} Events" %></h3>
    <% if policy(@events).download? %>
      <div class="d-flex flex-row-reverse mb-3">
        <%= link_to download_event_path(@questionnaire), class: "btn btn-primary" do %>
          <i class="fa-solid fa-file-arrow-down"></i> Events CSV
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover">
        <thead>
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Date</th>
            <th>Entered By</th>
            <th>Discard</th>
          </tr>
        </thead>
        <tbody>
          <% @events.each do |event| %>
            <tr>
              <td><%= link_to event.id, questionnaire_response_path(@questionnaire, event) %></td>
              <td><%= event.attribute(event.name_identifier) %></td>
              <td><%= event.attribute(event.date_identifier) %></td>
              <td><%= event.user.name %></td>
              <td>
                <% if policy(event).destroy? %>
                  <%= link_to 'Discard', event_path(id: @questionnaire.id, response_id: event.id), data: { turbo_method: :delete,  turbo_confirm: 'Are you sure you want to discard this event?' }, class: 'btn btn-sm btn-danger' %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card-footer">
    <% if policy(@questionnaire.responses.new).create? %>
      <div class="d-flex flex-row-reverse m-1">
        <%= link_to new_questionnaire_response_path(@questionnaire), class: "btn btn-primary fw-semibold" do %>
          <i class="fa-solid fa-plus"></i> New event
        <% end %>
      </div>
    <% end %>
  </div>
</div>
